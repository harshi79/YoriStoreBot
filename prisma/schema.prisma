generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum InventoryStatus {
  AVAILABLE
  SOLD
  REMOVED
}

enum CreditTransactionType {
  BONUS
  GIFT
  GIFT_ALL
  REDEEM
  PURCHASE
  REFUND
  ADMIN_ADJUSTMENT
}

model User {
  id                 String    @id @default(cuid())
  telegramId         BigInt    @unique @map("telegram_id")
  username           String?   @db.VarChar(64)
  firstName          String?   @map("first_name") @db.VarChar(128)
  lastName           String?   @map("last_name") @db.VarChar(128)
  credits            Int       @default(0)
  profilePhotoFileId String?   @map("profile_photo_file_id") @db.VarChar(512)
  dailyBonusAt       DateTime? @map("daily_bonus_at") @db.Timestamptz(6)
  lastActiveAt       DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  isBlocked          Boolean   @default(false) @map("is_blocked")

  purchases         Purchase[]
  inventoryItems    InventoryItem[]  @relation("InventoryPurchaser")
  codeRedemptions   CodeRedemption[]
  creditTransactions CreditTransaction[]

  @@index([lastActiveAt])
  @@index([createdAt])
  @@map("users")
}

model Category {
  id           String    @id @default(cuid())
  name         String    @unique @db.VarChar(80)
  description  String    @default("") @db.VarChar(500)
  emoji        String    @default("◈") @db.VarChar(16)
  displayOrder Int       @default(0) @map("display_order")
  enabled      Boolean   @default(true)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([enabled, displayOrder])
  @@map("categories")
}

model Product {
  id          String    @id @default(cuid())
  categoryId  String    @map("category_id")
  name        String    @db.VarChar(120)
  description String    @default("") @db.VarChar(2000)
  price       Int       @db.Integer
  emoji       String    @default("✦") @db.VarChar(16)
  enabled     Boolean   @default(true)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category  Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventory InventoryItem[]
  purchases Purchase[]

  @@unique([categoryId, name])
  @@index([categoryId, enabled, deletedAt])
  @@map("products")
}

model InventoryItem {
  id          String          @id @default(cuid())
  productId   String          @map("product_id")
  payload     String          @db.Text
  payloadHash String          @map("payload_hash") @db.VarChar(64)
  status      InventoryStatus @default(AVAILABLE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  purchasedAt DateTime?       @map("purchased_at") @db.Timestamptz(6)
  purchaserId String?         @map("purchaser_id")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaser User?    @relation("InventoryPurchaser", fields: [purchaserId], references: [id], onDelete: SetNull)
  purchase  Purchase?

  @@unique([productId, payloadHash])
  @@index([productId, status, createdAt])
  @@index([purchaserId])
  @@map("inventory_items")
}

model Purchase {
  id              String   @id @default(cuid())
  buyerId         String   @map("buyer_id")
  productId       String   @map("product_id")
  inventoryItemId String   @unique @map("inventory_item_id")
  idempotencyKey  String   @unique @map("idempotency_key") @db.VarChar(128)
  amountPaid      Int      @map("amount_paid")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  buyer         User          @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([buyerId, createdAt])
  @@index([productId, createdAt])
  @@map("purchases")
}

model RedeemCode {
  id             String    @id @default(cuid())
  code           String    @unique @db.VarChar(32)
  creditAmount   Int       @map("credit_amount")
  maxRedeems     Int       @map("max_redeems")
  currentRedeems Int       @default(0) @map("current_redeems")
  enabled        Boolean   @default(true)
  createdBy      BigInt    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz(6)

  redemptions CodeRedemption[]

  @@index([enabled, expiresAt])
  @@map("redeem_codes")
}

model CodeRedemption {
  id           String   @id @default(cuid())
  redeemCodeId String   @map("redeem_code_id")
  userId       String   @map("user_id")
  redeemedAt   DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)

  redeemCode RedeemCode @relation(fields: [redeemCodeId], references: [id], onDelete: Restrict)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([redeemCodeId, userId])
  @@index([userId, redeemedAt])
  @@map("code_redemptions")
}

model CreditTransaction {
  id             String                 @id @default(cuid())
  userId         String                 @map("user_id")
  amount         Int
  type           CreditTransactionType
  description    String                 @db.VarChar(500)
  relatedEntityId String?                @map("related_entity_id") @db.VarChar(128)
  batchId        String?                @map("batch_id") @db.VarChar(64)
  balanceAfter   Int                    @map("balance_after")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, batchId])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("credit_transactions")
}

model ResetChallenge {
  id              String    @id @default(cuid())
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64)
  ownerTelegramId BigInt    @map("owner_telegram_id")
  stage           Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt           DateTime? @map("used_at") @db.Timestamptz(6)

  @@index([expiresAt, usedAt])
  @@map("reset_challenges")
}

model AdminAudit {
  id              String   @id @default(cuid())
  ownerTelegramId BigInt   @map("owner_telegram_id")
  action           String   @db.VarChar(80)
  details          Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@map("admin_audit")
}

model AppSetting {
  key       String   @id @db.VarChar(80)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}
