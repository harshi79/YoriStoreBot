# Create the bot with @BotFather. Never commit a real .env file.
BOT_TOKEN=

# Required in production. Replace all placeholders with your PostgreSQL connection.
# Never falls back to another database when this connection fails.
# In development only, an empty URL selects disk-backed .pglite/iris storage.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/iris?schema=public

# The owner ID is fixed in src/config/env.ts.
# Production is the default when NODE_ENV is unset. Set it explicitly on your host.
# The development value below opts into local disk-backed PGlite when the URL is empty.
NODE_ENV=development
LOG_LEVEL=info

# Daily credit bonus configuration.
BONUS_CREDITS=25
BONUS_PERIOD_HOURS=24
DATABASE_POOL_SIZE=10

# Optional: set only when the bot is actually managed by PM2.
PM2_APP_NAME=

# Public HTTPS address of the Mini App; never put a bot token in this URL.
# npm start serves both the bot and the built Mini App/API on PORT.
MINI_APP_URL=
PORT=3000
